{
  "app-id": "org.siriusos.SoberShaderManager",
  "runtime": "org.gnome.Platform",
  "runtime-version": "51",
  "sdk": "org.gnome.Sdk",
  "command": "sober-shader-manager",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri",
    "--talk-name=org.freedesktop.Flatpak",
    "--env=SOBER_SHADER_HOST_FLATPAK=1",
    "--filesystem=~/.var/app/org.vinegarhq.Sober/config/vkBasalt:create",
    "--filesystem=~/GShade-Shaders:ro"
  ],
  "modules": [
    {
      "name": "sober-shader-manager",
      "buildsystem": "simple",
      "build-commands": [
        "mkdir -p /app/lib/sober-shader",
        "cp -r core cli gui /app/lib/sober-shader/",
        "mkdir -p /app/share/sober-shader/shaders",
        "cp -r shaders/. /app/share/sober-shader/shaders/",
        "install -Dm755 sober-shader-wrapper.sh /app/bin/sober-shader",
        "install -Dm755 sober-shader-manager-wrapper.sh /app/bin/sober-shader-manager",
        "install -Dm644 org.siriusos.SoberShaderManager.desktop /app/share/applications/org.siriusos.SoberShaderManager.desktop",
        "install -Dm644 sirius.png /app/share/icons/hicolor/512x512/apps/org.siriusos.SoberShaderManager.png",
        "install -Dm644 org.siriusos.SoberShaderManager.metainfo.xml /app/share/metainfo/org.siriusos.SoberShaderManager.metainfo.xml"
      ],
      "sources": [
        {"type": "file", "path": "sober-shader-wrapper.sh"},
        {"type": "file", "path": "sober-shader-manager-wrapper.sh"},
        {"type": "file", "path": "org.siriusos.SoberShaderManager.desktop"},
        {"type": "file", "path": "sirius.png"},
        {"type": "file", "path": "org.siriusos.SoberShaderManager.metainfo.xml"},
        {
          "type": "dir",
          "path": ".",
          "skip": [
            ".venv",
            ".git",
            ".pytest_cache",
            "tests",
            "docs",
            "scripts",
            "flatpak-probe",
            "build-dir",
            "deploy-repo",
            "__pycache__",
            "*.pyc"
          ]
        }
      ]
    }
  ]
}
